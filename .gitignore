# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wzorzec bez wartości - ma być w repozytorium, bo to jedyna lista wymaganych zmiennych
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kopiowane z node_modules przez scripts/copy-maplibre-worker.mjs
/public/maplibre

# lokalna konfiguracja narzedzi
/.claude/
