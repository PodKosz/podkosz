# =====================================================================
#  Zmienne środowiskowe PodKosz
#
#  Skopiuj do `.env.local` (lokalnie) albo wklej na Vercelu w Settings →
#  Environment Variables. Plik `.env.local` jest w .gitignore i nigdy nie
#  trafia do repozytorium - repozytorium jest publiczne.
#
#  Kolumna „bez tego": co dokładnie przestaje działać, gdy zmiennej brak.
# =====================================================================

# ---------- WYMAGANE ----------

# Adres i klucz publiczny projektu Supabase (Settings → API).
# Klucz publiczny jest z założenia jawny - dostępu pilnują polityki RLS w bazie.
# Bez tego: nie działa nic poza stroną statyczną - baza, logowanie, zdjęcia.
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------- POCZTA (Resend) ----------

# Klucz z resend.com → API Keys.
# Bez tego: żaden mail nie wychodzi, ale serwis działa normalnie.
RESEND_API_KEY=re_...

# Nadawca. MUSI być adresem z domeny potwierdzonej w Resend (rekordy DKIM/SPF w DNS).
# Bez tego: listy do użytkowników (powitanie, decyzja o zgłoszeniu, otwarcie serwisu)
# NIE są wysyłane - trasy odmawiają zamiast udawać, że poszło. Opinie do właściciela
# lecą dalej adresem testowym Resend.
FEEDBACK_FROM=PodKosz <kontakt@podkosz.pl>

# Skrzynka, na którą przychodzą opinie z formularza i „odpowiedz do" w listach.
# Bez tego: opinie zostają w bazie i widać je w panelu, ale nie przychodzą mailem.
FEEDBACK_TO=podkoszpl@gmail.com

# ---------- MAPA ----------

# Klucz do kafelków CARTO z formularza carto.com/basemaps/apikey (darmowy do 5 mln
# kafelków miesięcznie, wymaga zostawienia atrybucji - jest w stopce mapy).
# Uwaga: parametr nazywa się `key`, nie `api_key`, a to NIE jest token z CARTO Workspace.
# Bez tego: mapa jedzie na zapasowym podkładzie Esri - działa, ale wygląda inaczej.
NEXT_PUBLIC_CARTO_KEY=

# ---------- ZASŁONA PRZED PREMIERĄ ----------

# Ustaw na 1, żeby otworzyć serwis dla wszystkich. Brak zmiennej = zasłona włączona:
# każdy adres pokazuje „Już niedługo", a wyszukiwarki dostają noindex.
PODKOSZ_OTWARTA=

# Klucz do furtki `podkosz.pl/?wpusc=<klucz>` - dla beta testerów bez konta.
# Bez tego: furtka nie istnieje. Administrator i tak wchodzi przez zalogowanie.
# NIE wpisuj tu wartości domyślnej w kodzie - repozytorium jest publiczne.
PODKOSZ_KLUCZ=

# ---------- POZOSTAŁE ----------

# Adres serwisu. Używany w listach, danych strukturalnych i nagłówku dla Nominatim.
# Bez tego: domyślnie https://podkosz.pl (do nadpisania w podglądach Vercela).
NEXT_PUBLIC_SITE_URL=

# Profil na Instagramie - trafia do danych strukturalnych `sameAs` dla Google.
# Bez tego: brak powiązania strony z profilem w wynikach wyszukiwania.
NEXT_PUBLIC_INSTAGRAM=

# Sekret dla codziennego zadania utrzymaniowego (Vercel → Settings → Cron Jobs).
# Vercel sam dokłada go w nagłówku. Bez tego: trasa /api/utrzymanie jest otwarta,
# ale i tak tylko czyta jeden wiersz i niczego nie ujawnia.
CRON_SECRET=
